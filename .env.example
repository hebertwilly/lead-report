# URL do projeto Supabase (ex.: https://seu-projeto.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anon/publishable do projeto Supabase. Pode ser exposta no navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente para scripts administrativos executados no servidor/terminal.
# Nunca use prefixo NEXT_PUBLIC e nunca exponha esta chave no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Não persista senhas de bootstrap em arquivos .env. Os scripts exigem esta
# variável apenas no processo que os executa.
# LEAD_REPORT_BOOTSTRAP_PASSWORD=
